# Copy to /etc/event-manager/alerts.env and secure with: chmod 600 /etc/event-manager/alerts.env

# Optional: Generic webhook endpoint (Slack/Teams/Discord/custom)
# Used as fallback transport and for notifications without per-tenant webhook override.
ALERT_WEBHOOK_URL=""

# Optional: Comma-separated or single email recipient (depends on local MTA/mail setup)
# Used as fallback recipient list when no recipient emails are resolved from settings.
ALERT_EMAIL_TO=""
ALERT_FROM="event-manager@localhost"
ALERT_PREFIX="[event-manager]"

# System health thresholds
# Fallback thresholds. SUPER_ADMIN can override in Settings -> System Health Alerts.
WARN_DISK_PCT=80
CRIT_DISK_PCT=90
WARN_MEM_PCT=85
CRIT_MEM_PCT=92

# Optional DB connection override for alert scripts.
# Prefer DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# If DB_URL is used, ensure it is libpq-compatible (do not include Prisma-only query params like ?schema=public).
# DB_HOST="127.0.0.1"
# DB_PORT="5432"
# DB_NAME="event_manager"
# DB_USER="event_manager"
# DB_PASSWORD="your_password"
# DB_URL="postgresql://event_manager:your_password@127.0.0.1:5432/event_manager?sslmode=disable"

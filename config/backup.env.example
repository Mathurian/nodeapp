# Copy to /etc/event-manager/backup.env and secure with:
#   sudo chmod 600 /etc/event-manager/backup.env
#
# This file overrides backup defaults from:
#   /var/www/event-manager/config/backup.config.sh
#
# Note: Super Admin UI backup settings are written to:
#   /var/www/event-manager/config/backup.runtime.env
# and loaded after this file (higher precedence).

# Local retention windows (days)
RETENTION_DAYS_FULL_LOCAL=30
RETENTION_DAYS_INCREMENTAL_LOCAL=14
RETENTION_DAYS_PITR_LOCAL=14

# Minimum number to keep per backup type
MIN_BACKUPS_TO_KEEP_FULL=7
MIN_BACKUPS_TO_KEEP_INCREMENTAL=28
MIN_BACKUPS_TO_KEEP_PITR=4

# Backup-script log retention (days)
LOG_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Off-host backup integration
# -----------------------------------------------------------------------------
# Enable remote replication from backup scripts:
# REMOTE_BACKUP_ENABLED=true

# Option 1: S3-compatible object storage
# REMOTE_BACKUP_TYPE=s3
# S3_BUCKET=event-manager-backups
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Option 2: rsync over SSH
# REMOTE_BACKUP_TYPE=rsync
# REMOTE_BACKUP_HOST=backup.example.com
# REMOTE_BACKUP_USER=backupuser
# REMOTE_BACKUP_PATH=/srv/backups/event-manager

# Option 3: sftp/scp over SSH
# REMOTE_BACKUP_TYPE=sftp
# REMOTE_BACKUP_HOST=backup.example.com
# REMOTE_BACKUP_PORT=22
# REMOTE_BACKUP_USER=backupuser
# REMOTE_BACKUP_PATH=/srv/backups/event-manager

# Option 4: rclone target (S3/Azure/GCS/Backblaze/etc)
# REMOTE_BACKUP_TYPE=rclone
# RCLONE_REMOTE=remote:bucket/path

{
  "name": "event-manager-backend",
  "version": "1.0.0",
  "description": "Event Manager Contest System - Node.js Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build:offline-write-ownership": "node scripts/build/generate-offline-write-ownership-manifest.js",
    "sign:offline-write-ownership": "node scripts/build/sign-offline-write-ownership-manifest.js",
    "build": "npm run build:offline-write-ownership && tsc",
    "test": "bash scripts/test-backend-jest.sh",
    "test:unit": "node --max-old-space-size=4096 node_modules/.bin/jest --runInBand --no-forceExit --openHandlesTimeout=10000 --testPathPatterns=tests/unit",
    "test:integration": "bash scripts/test-backend-jest.sh --prepare-db --no-forceExit --openHandlesTimeout=10000 --testPathPatterns=tests/integration",
    "test:contracts": "bash scripts/test-backend-jest.sh --prepare-db --no-forceExit --openHandlesTimeout=10000 --testPathPatterns=tests/contracts",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:typecheck": "tsc --project tsconfig.test.json --noEmit",
    "test:db:setup": "bash scripts/test-db-setup.sh",
    "test:db:teardown": "bash scripts/test-db-teardown.sh",
    "test:e2e:pw": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:comprehensive": "playwright test tests/e2e/comprehensive",
    "test:e2e:workflows": "playwright test tests/e2e/*workflow*.spec.ts",
    "audit:tenant-segregation": "bash scripts/ops/tenant-segregation-audit.sh",
    "audit:tenant-matrix": "node scripts/ops/generate-tenant-enforcement-matrix.js",
    "audit:tenant-fk-consistency": "bash scripts/ops/audit-tenant-fk-consistency.sh",
    "audit:tenant-rls-shadow": "bash scripts/ops/tenant-rls-shadow-check.sh",
    "audit:tenant-prisma-imports": "bash scripts/ops/tenant-prisma-import-guard.sh",
    "ops:tenant-segregation-alerts": "bash scripts/ops/tenant-segregation-alerts.sh",
    "test:tenant-guardrails": "bash scripts/ops/tenant-segregation-audit.sh && bash scripts/ops/tenant-prisma-import-guard.sh && node scripts/verify-tenant-scoped-models.js",
    "deploy:preflight:tenant-segregation": "bash scripts/deploy/preflight-tenant-segregation.sh",
    "deploy:prisma-baseline": "bash scripts/deploy/prisma-baseline-align.sh",
    "test:tenant-scopes": "node scripts/verify-tenant-scoped-models.js",
    "test:frontend": "cd frontend && npm run test",
    "test:frontend:ui": "cd frontend && npm run test:ui",
    "test:visual": "cd frontend && npm run test:visual",
    "test:a11y": "cd frontend && npm run test:a11y",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "db:seed": "echo 'Use TestEventSetupPage in the UI for demo data'",
    "prisma:generate": "prisma generate",
    "load:smoke": "k6 run tests/load/smoke-test.js",
    "load:test": "k6 run tests/load/load-test.js",
    "load:stress": "k6 run tests/load/stress-test.js",
    "load:all": "npm run load:smoke && npm run load:test",
    "cache:clear": "redis-cli FLUSHDB",
    "cache:stats": "redis-cli INFO stats",
    "cache:monitor": "redis-cli MONITOR",
    "db:optimize": "npx prisma migrate deploy && npm run db:stats",
    "db:stats": "psql $DATABASE_URL -c 'SELECT schemaname, tablename, pg_size_pretty(pg_total_relation_size(schemaname||''.''||tablename)) AS size FROM pg_tables WHERE schemaname = ''public'' ORDER BY pg_total_relation_size(schemaname||''.''||tablename) DESC;'",
    "deploy:check": "npm run test && npm run load:smoke && npm run build && cd frontend && npm run build",
    "deploy:prod": "npm run deploy:check && sudo systemctl restart event-manager",
    "health:check": "curl http://localhost:3000/health",
    "health:db": "psql $DATABASE_URL -c 'SELECT 1;'",
    "health:redis": "redis-cli ping"
  },
  "keywords": [
    "event-management",
    "contest-system",
    "scoring",
    "judging"
  ],
  "author": "Event Manager Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@azure/storage-blob": "^12.29.1",
    "@google-cloud/storage": "^7.17.3",
    "@prisma/client": "^5.19.1",
    "@sentry/node": "^10.25.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/handlebars": "^4.0.40",
    "@types/node-cache": "^4.1.3",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/ssh2-sftp-client": "^9.0.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.63.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "playwright": "^1.40.0",
    "prisma": "^5.19.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.15.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "ssh2-sftp-client": "^12.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "jest": "^30.2.0",
    "jest-mock-extended": "^3.0.7",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.5",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "glob": "^10.3.10",
    "rimraf": "^5.0.5",
    "inflight": "npm:lru-cache@^10.0.0",
    "are-we-there-yet": "npm:@types/are-we-there-yet@^2.0.0",
    "lodash.pick": "npm:lodash@^4.17.21",
    "gauge": "npm:@types/gauge@^2.7.2",
    "npmlog": "npm:winston@^3.11.0",
    "supertest": "$supertest",
    "superagent": "^10.2.2",
    "html-pdf-node": "npm:playwright@^1.40.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^0.1.0",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.18.0",
    "eslint": "^9.0.0"
  }
}

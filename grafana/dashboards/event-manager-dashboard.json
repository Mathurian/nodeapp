{
  "dashboard": {
    "title": "Event Manager Performance Dashboard",
    "tags": ["event-manager", "performance", "activity"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 2,
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "tenantId",
          "type": "query",
          "label": "Tenant",
          "datasource": "Prometheus",
          "query": {
            "query": "label_values(users_active_total, tenant_name)",
            "refId": "tenantIdQuery"
          },
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "current": {
            "selected": true,
            "text": "All",
            "value": ".*"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum by (tenant_name, method, route) (rate(http_requests_total{tenant_name=~\"$tenantId\"}[5m]))",
            "legendFormat": "{{tenant_name}} {{method}} {{route}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "HTTP Request Duration (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, tenant_name) (rate(http_request_duration_seconds_bucket{tenant_name=~\"$tenantId\"}[5m])))",
            "legendFormat": "{{tenant_name}} p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Live Active Users",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "sum(active_user_sessions_total{tenant_name=~\"$tenantId\"})",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 4,
        "title": "Recently Active Users (24h)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
        "targets": [
          {
            "expr": "sum(users_recent_24h_total{tenant_name=~\"$tenantId\"})",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": ""
          },
          "orientation": "horizontal",
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 5,
        "title": "Live Active Users by Role",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum by (tenant_name, role) (active_user_sessions_by_role_total{tenant_name=~\"$tenantId\"})",
            "legendFormat": "{{tenant_name}} {{role}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Recently Active Users by Role (24h)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "sum by (tenant_name, role) (users_recent_24h_by_role_total{tenant_name=~\"$tenantId\"})",
            "legendFormat": "{{tenant_name}} {{role}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "sum by (tenant_name, error_type) (rate(http_request_errors_total{tenant_name=~\"$tenantId\"}[5m]))",
            "legendFormat": "{{tenant_name}} {{error_type}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Active Connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "active_connections",
            "legendFormat": "Connections",
            "refId": "A"
          }
        ]
      },
      {
        "id": 9,
        "title": "Database Query Duration",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, tenant_name, operation, table) (rate(database_query_duration_seconds_bucket{tenant_name=~\"$tenantId\"}[5m])))",
            "legendFormat": "{{tenant_name}} {{operation}} {{table}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "Cache Performance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [
          {
            "expr": "sum by (tenant_name) (rate(cache_hits_total{tenant_name=~\"$tenantId\"}[5m]))",
            "legendFormat": "{{tenant_name}} Hits",
            "refId": "A"
          },
          {
            "expr": "sum by (tenant_name) (rate(cache_misses_total{tenant_name=~\"$tenantId\"}[5m]))",
            "legendFormat": "{{tenant_name}} Misses",
            "refId": "B"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}

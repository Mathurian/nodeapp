# Test Environment Configuration
# Use with: NODE_ENV=test node dist/server.js
# Or: npm run test:e2e

NODE_ENV=test
PORT=3001

# Database Configuration - TEST DATABASE ONLY
# CRITICAL: Tests must NEVER use production database
DATABASE_URL="postgresql://event_manager:dittibop@localhost:5432/event_manager_test?schema=public"

# JWT Configuration - Simple for testing
JWT_SECRET="test-jwt-secret-key-for-testing-only"
JWT_EXPIRES_IN=1h

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_DB=1
CACHE_ENABLED=true

# File Upload Configuration
UPLOAD_DIR=uploads/test
MAX_FILE_SIZE=10485760

# Security Configuration - Fast for testing
BCRYPT_ROUNDS=4
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# Logging Configuration
LOG_LEVEL=warn
LOG_FILE=logs/event-manager-test.log
DISABLE_FILE_LOGGING=true

# Email Configuration - Disabled for tests
SMTP_ENABLED=false

# Session Configuration
SESSION_SECRET="test-session-secret-for-testing-only"
SESSION_TIMEOUT=1800000

# Application Configuration
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# CSRF Protection
CSRF_SECRET="test-csrf-secret-for-testing-only"
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

COOKIE_SECRET="test-cookie-secret-for-testing-only"

# Test Features
SKIP_EMAIL=true
SKIP_EXTERNAL_SERVICES=true
